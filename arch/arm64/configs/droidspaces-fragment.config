# Droidspaces v6.6.0 kernel requirements -- non-GKI (kernel 4.9) fragment
#
# Source (commit-anchored, not tag-guessed):
#   ravindu644/Droidspaces-OSS  tag v6.6.0 = cff50fa04d50472b607ba6822e8bf482b19cd427
#   Documentation/Kernel-Configuration.md -> "Configuring Non-GKI Kernels (Legacy Kernels)"
#
# Baseline: PixelExperience-Devices/kernel_lenovo_kunlun2, branch eleven (4.9.268).
# Merge into the defconfig with tools/merge-config-fragment.py (idempotent, in place).
#
# Symbols listed by upstream that this tree does NOT define are omitted on purpose
# (verified against every Kconfig in the tree, 2026-11-11):
#   CONFIG_FW_LOADER_COMPRESS              symbol introduced in 4.18
#   CONFIG_NETFILTER_XT_TARGET_MASQUERADE  4.9 exposes IP_NF_TARGET_MASQUERADE instead
#   CONFIG_NETFILTER_XT_TARGET_REJECT      4.9 exposes IP_NF_TARGET_REJECT instead
#   CONFIG_NF_CONNTRACK_NETLINK            not present in this base
#   CONFIG_IP_NF_TARGET_ULOG               not present in this base (upstream removed in 4.15)
# CONFIG_IPC_NS is not set explicitly: it is auto-selected by SYSVIPC || POSIX_MQUEUE.

# IPC mechanisms
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y

# Fix for docker/runc "unsafe procfs" error
CONFIG_USER_NS=y

# Seccomp support
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups support
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# Device filesystem support
CONFIG_DEVTMPFS=y

# Overlay filesystem support (volatile mode)
CONFIG_OVERLAY_FS=y

# xattr / posix acl on tmpfs (NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Firmware loading support
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# Network isolation support -- NAT/none modes
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# 4.9 legacy compat
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# Must be OFF on legacy kernels or containers get no internet:
# the kernel gates socket creation on the caller's AID group.
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# Firewall support inside containers (UFW / fail2ban) -- use NAT mode
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# nftables usability (4.9 keeps every family/expression as its own symbol;
# NF_TABLES alone gives a core that can create no table). Not required by the
# upstream doc -- it lists only NF_TABLES -- but a container running `nft` needs it.
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_CT=y
CONFIG_NFT_META=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_HASH=y
CONFIG_NFT_SET_HASH=y
CONFIG_NFT_SET_RBTREE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_EXTHDR=y
